<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Water Intake"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="16dp" />

    <RelativeLayout
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginTop="40dp">

        <ProgressBar
            android:id="@+id/pb_water"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@android:drawable/progress_horizontal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_centerInParent="true"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_current_ml"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 ml"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/primary_blue" />

            <TextView
                android:id="@+id/tv_goal_ml"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Goal: 2000 ml"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black" />
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/tv_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Syncing weather &amp; activity..."
        android:layout_marginTop="24dp"
        android:textColor="@color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="48dp"
        android:gravity="center">

        <Button
            android:id="@+id/btn_add_250"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:text="+250ml"
            android:background="@drawable/capsule_button_blue"
            android:textColor="@color/white"
            android:layout_marginEnd="8dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:backgroundTint="@null"
            style="@style/Widget.Material3.Button" />

        <Button
            android:id="@+id/btn_add_500"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:text="+500ml"
            android:background="@drawable/capsule_button_blue"
            android:textColor="@color/white"
            android:layout_marginStart="8dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:backgroundTint="@null"
            style="@style/Widget.Material3.Button" />
    </LinearLayout>

</LinearLayout>
